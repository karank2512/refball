# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.env

# Caches
.ruff_cache/
.pytest_cache/
.ipynb_checkpoints/
.DS_Store

# Data + model artifacts are reproducible from the pipeline.
# Raw/interim caches and large model traces are NOT committed.
data/raw/*
data/interim/*
data/external/*
!data/**/.gitkeep
models/*.nc
models/*.zarr
reports/figures/*.png
reports/figures/*.html

# Keep processed tables/artifacts out of git by default (regenerated by the pipeline).
# Comment these out if you want to commit small demo tables for instant app rendering.
data/processed/*.parquet
data/processed/*.csv
data/processed/*.json
data/processed/*.jsonl
data/processed/robustness/
!data/processed/.gitkeep
